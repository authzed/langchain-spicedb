# OpenAI API Key (optional - only needed for examples that use LLMs)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# SpiceDB Configuration (required)
# Default values work with: docker run -p 50051:50051 authzed/spicedb serve --grpc-preshared-key "somerandomkeyhere" --grpc-no-tls
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_TOKEN=somerandomkeyhere

# Subject ID (optional - used in retriever examples to specify which user)
# Change this to test different users: alice, bob, tim, etc.
SUBJECT_ID=alice
