# SpiceDB Configuration (Required)
SPICEDB_ENDPOINT=localhost:50051
SPICEDB_TOKEN=somerandomkeyhere

# Subject ID - the user to test as (Required)
# Options: tim, alice, or any user you've created relationships for
SUBJECT_ID=tim

# OpenAI API Key (Optional - only needed for full RAG demos)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
